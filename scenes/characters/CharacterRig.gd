class_name CharacterRig
extends Node2D
## Cut-out character made of the vector parts in art/characters/<name>/ (generated by
## tools/gen_sprites.py from the vector pack). Animated procedurally from the player's
## state every frame: idle breathing and blinking, walk cycle, jump / fall poses,
## climbing, riding, carrying, balloon float, call wave, hugs, squash & stretch.
##
## The origin is the ground point under the feet, so squash & stretch stays anchored.
## Parts are textures rendered at 2x and drawn at `part_scale`.

## Pixels per pack unit on screen (the pack's head radius is 123 units).
const U := 0.15

@export var part_scale: float = 0.5
## How fast poses blend (higher = snappier).
@export var blend_rate: float = 18.0
## Pixels of travel per walk-cycle radian.
@export var stride: float = 14.0

var _arm_back: Sprite2D
var _arm_front: Sprite2D
var _foot_back: Sprite2D
var _foot_front: Sprite2D
var _ear_l: Sprite2D
var _ear_r: Sprite2D
var _body: Sprite2D
var _head: Sprite2D
var _face: Sprite2D
var _faces: Dictionary = {}

var _t: float = 0.0
var _phase: float = 0.0
# Blended pose values.
var _arm_l: float = 0.3
var _arm_r: float = -0.3
var _foot_l := Vector2.ZERO
var _foot_r := Vector2.ZERO
var _bob: float = 0.0
var _tilt: float = 0.0
var _face_x: float = 0.0

const FOOT_BASE := Vector2(60.0 * U, -28.0 * U)
const BODY_Y := -168.0 * U
const HEAD_Y := -301.0 * U
const EAR := Vector2(82.0 * U, -74.0 * U)
const SHOULDER := Vector2(92.0 * U, -78.0 * U)


## Builds the parts from `dir` (e.g. "res://art/characters/bubu"). False if art is missing.
func setup(dir: String) -> bool:
	if not ResourceLoader.exists(dir.path_join("head.svg")):
		return false
	_arm_back = _part(dir, "arm")
	_foot_back = _part(dir, "foot")
	_ear_l = _part(dir, "ear")
	_ear_r = _part(dir, "ear")
	_body = _part(dir, "body")
	_foot_front = _part(dir, "foot")
	_arm_front = _part(dir, "arm")
	_head = _part(dir, "head")
	for kind in ["open", "blink", "happy", "oh"]:
		_faces[kind] = load(dir.path_join("face_%s.svg" % kind))
	_face = _part(dir, "face_open")
	# Arms hang over the body like in the illustrations, under the head.
	move_child(_arm_back, _body.get_index() + 1)
	move_child(_arm_front, _arm_back.get_index() + 1)
	return true


func _part(dir: String, part: String) -> Sprite2D:
	var s := Sprite2D.new()
	s.texture = load(dir.path_join(part + ".svg"))
	s.scale = Vector2.ONE * part_scale
	add_child(s)
	return s


## Called by the player every physics frame.
func animate(pl: BasePlayer, delta: float) -> void:
	_t += delta
	var k := 1.0 - exp(-blend_rate * delta)
	var on_floor := pl.is_on_floor()
	var vx := pl.velocity.x
	var vy := pl.velocity.y
	var face := "open"
	# Targets (radians: 0 = arm hanging down, + swings the left arm outwards).
	var arm_l := 0.3
	var arm_r := -0.3
	var foot_l := Vector2.ZERO
	var foot_r := Vector2.ZERO
	var bob := 0.0
	var tilt := 0.0
	var breathe := 1.0

	match pl.state:
		BasePlayer.State.BALLOON:
			arm_l = 2.9
			arm_r = -2.9
			foot_l = Vector2(1.0, -1.0 + sin(_t * 3.0) * 1.5)
			foot_r = Vector2(-1.0, -1.0 - sin(_t * 3.0) * 1.5)
			tilt = sin(_t * 2.0) * 0.08
			face = "oh" if pl._balloon_time < 0.6 else "happy"
		BasePlayer.State.RIDING:
			# Sitting on the partner's back: legs apart, arms holding on.
			arm_l = 1.1 + sin(_t * 2.0) * 0.08
			arm_r = -1.1 - sin(_t * 2.0) * 0.08
			foot_l = Vector2(-6.0, -3.0)
			foot_r = Vector2(6.0, -3.0)
			face = "happy"
		BasePlayer.State.CLIMBING:
			_phase += delta * absf(vy) / stride
			arm_l = 2.7 + sin(_phase) * 0.35
			arm_r = -2.7 + sin(_phase) * 0.35
			foot_l = Vector2(0.0, -maxf(0.0, sin(_phase)) * 4.0)
			foot_r = Vector2(0.0, -maxf(0.0, -sin(_phase)) * 4.0)
		_:
			if on_floor:
				if absf(vx) > 20.0:
					_phase += delta * absf(vx) / stride
					var s := sin(_phase)
					foot_l = Vector2(cos(_phase) * 3.0, -maxf(0.0, s) * 4.0)
					foot_r = Vector2(-cos(_phase) * 3.0, -maxf(0.0, -s) * 4.0)
					arm_l = 0.35 + s * 0.55
					arm_r = -0.35 + s * 0.55
					bob = -absf(s) * 2.0
					tilt = 0.07 * signf(vx)
				else:
					breathe = 1.0 + sin(_t * 2.4) * 0.025
					arm_l = 0.3 + sin(_t * 2.4) * 0.05
					arm_r = -0.3 - sin(_t * 2.4) * 0.05
			elif vy < 0.0:
				arm_l = 2.3
				arm_r = -2.3
				foot_l = Vector2(2.0, -3.0)
				foot_r = Vector2(-2.0, -1.0)
			else:
				arm_l = 1.5 + sin(_t * 18.0) * 0.1
				arm_r = -1.5 - sin(_t * 18.0) * 0.1
				foot_l = Vector2(-1.0, -1.0)
				foot_r = Vector2(1.0, -2.0)
				if vy > 380.0:
					face = "oh"
			if pl.is_on_wall_only() and not on_floor and vy > 0.0 and pl.can_wall_jump:
				arm_l = 2.2
				arm_r = -2.2
				face = "oh"
	# Overlays that hold for any state.
	if pl.carried_item != null:
		arm_l = 2.95
		arm_r = -2.95
	elif pl.rider != null:
		arm_l = 2.0
		arm_r = -2.0
		face = "happy"
	if pl._assist_down and pl._assist_held_time > pl.assist_tap_max_time:
		# Waving the partner over (the "saluto" pose).
		arm_r = -2.5 - sin(_t * 14.0) * 0.45
		face = "happy"
	if pl._hearts_time > 0.0:
		# Hug: the front arm reaches around the partner, the other one across the chest.
		arm_l = -0.6
		arm_r = -1.75
		face = "happy"
	if pl._shake_time > 0.0:
		face = "oh"
	if face == "open" and pl._blink_time <= 0.0:
		face = "blink"

	_arm_l = lerpf(_arm_l, arm_l, k)
	_arm_r = lerpf(_arm_r, arm_r, k)
	_foot_l = _foot_l.lerp(foot_l, k)
	_foot_r = _foot_r.lerp(foot_r, k)
	_bob = lerpf(_bob, bob, k)
	_tilt = lerpf(_tilt, tilt, k)
	_face_x = lerpf(_face_x, 5.0, k)

	# Whole-rig transform: facing flip, squash & stretch, "nope" shake. "Reduce motion"
	# keeps a hint of each (they still read as feedback) but much gentler.
	var m := lerpf(0.35, 1.0, UiTheme.motion())
	var shake := sin(pl._shake_time * 60.0) * 4.0 * (pl._shake_time / 0.3) * m
	position = Vector2(shake, pl._body_size.y * 0.5)
	# The parts are drawn for a 60 px tall body; bigger characters scale up.
	var size_k := pl._body_size.y / 60.0
	var fx := Vector2.ONE.lerp(pl._fx_scale, m)
	scale = Vector2(fx.x * float(pl.facing), fx.y) * size_k
	rotation = _tilt * m

	var body_pos := Vector2(0.0, BODY_Y + _bob)
	_body.position = body_pos
	_body.scale = Vector2(part_scale / sqrt(breathe), part_scale * breathe)
	_foot_back.position = Vector2(-FOOT_BASE.x, FOOT_BASE.y) + _foot_l
	_foot_front.position = FOOT_BASE + _foot_r
	_arm_back.position = body_pos + Vector2(-SHOULDER.x, SHOULDER.y)
	_arm_back.rotation = _arm_l
	_arm_front.position = body_pos + SHOULDER
	_arm_front.rotation = _arm_r
	var head_pos := Vector2(0.0, HEAD_Y + _bob * 1.2 + (breathe - 1.0) * -30.0)
	_head.position = head_pos
	_head.rotation = _tilt * 0.5
	_ear_l.position = head_pos + Vector2(-EAR.x, EAR.y)
	_ear_r.position = head_pos + EAR
	_face.position = head_pos + Vector2(_face_x, 0.0)
	_face.rotation = _head.rotation
	_face.texture = _faces.get(face, _faces["open"])


## Top of the head relative to the player origin (for tags and rings above it).
func head_top() -> float:
	return HEAD_Y - 130.0 * U
